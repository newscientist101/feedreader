# Domain name for your feedreader instance (required)
DOMAIN=feeds.example.com

# feedreader container image (published to Google Artifact Registry).
# Defaults are baked into docker-compose.yml; override here only if you fork
# the registry path or want to pin a different tag.
#
# FEEDREADER_IMAGE=us-central1-docker.pkg.dev/feedreader-489315/my-repo/feedreader
# IMAGE_TAG=main
