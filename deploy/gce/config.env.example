# Shared configuration for the feedreader GCE / Container-Optimized OS scripts.
#
# Copy this file to config.env and edit the values, then run:
#   ./setup-vm.sh    # provision a brand-new VM
#   ./update-vm.sh   # pull the latest :main image onto an existing VM
#
# Both scripts source config.env from this directory.

# ── Google Cloud project / location ──────────────────────────────────
PROJECT_ID=feedreader-489315
REGION=us-central1
ZONE=us-central1-a

# ── The VM ───────────────────────────────────────────────────────────
INSTANCE_NAME=feedreader
# e2-micro in us-west1/us-central1/us-east1 is covered by the GCP Always
# Free tier (1 non-preemptible instance, hours-equal-to-the-month). It has
# only ~1 GB RAM, which is tight for the 3-container stack — see README
# for the swapfile note if Authelia/Caddy get OOM-killed.
MACHINE_TYPE=e2-micro
# Boot disk: the free tier covers 30 GB-months of *standard* persistent
# disk only. pd-balanced/pd-ssd are NOT free, so keep type=pd-standard and
# size <= 30GB to avoid charges.
BOOT_DISK_SIZE=30GB
BOOT_DISK_TYPE=pd-standard
# Container-Optimized OS image family. 'cos-stable' tracks the current
# stable milestone and receives automatic security updates.
IMAGE_FAMILY=cos-stable
IMAGE_PROJECT=cos-cloud

# Network tag applied to the instance and targeted by the HTTP/HTTPS
# firewall rule the setup script creates.
NETWORK_TAG=feedreader-https

# ── Service account ──────────────────────────────────────────────────
# The runtime identity of the VM. It only needs to *read* from Artifact
# Registry (roles/artifactregistry.reader). setup-vm.sh creates it if it
# does not already exist. With this SA attached, docker-credential-gcr
# (pre-installed on COS) authenticates to GAR using a token from the
# metadata server — no key files are ever created or copied.
SA_NAME=feedreader-vm
# Derived; leave as-is unless you use an existing SA in another project.
SA_EMAIL=${SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com

# ── Artifact Registry image ──────────────────────────────────────────
# Must match .github/workflows/google.yml and deploy/docker-compose.yml.
GAR_LOCATION=us-central1
GAR_REPOSITORY=my-repo
GAR_IMAGE=feedreader
# Moving per-branch tag the deployment tracks.
IMAGE_TAG=main

# ── Application config ───────────────────────────────────────────────
# Domain that Caddy will obtain a Let's Encrypt certificate for. You MUST
# point an A record at this VM's static IP before the cert can issue;
# setup-vm.sh reserves the IP first and waits for DNS to resolve to it.
DOMAIN=feeds.example.com

# Authelia bootstrap user (password is only used for the very first login
# before you register a passkey). setup-vm.sh prompts for the password.
ADMIN_USERNAME=admin
ADMIN_DISPLAYNAME=Admin User
ADMIN_EMAIL=admin@example.com
